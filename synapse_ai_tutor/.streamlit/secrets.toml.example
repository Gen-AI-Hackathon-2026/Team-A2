# secrets.toml.example — Copy this to .streamlit/secrets.toml and fill in your keys.
# The actual secrets.toml is git-ignored to protect API keys.

# ── Voice Mode ────────────────────────────────────────────────────────────────
# Options: "hackathon" (default, local only) | "standard" | "premium"
VOICE_MODE = "hackathon"

# ── ElevenLabs (optional premium TTS) ────────────────────────────────────────
[elevenlabs]
ELEVENLABS_API_KEY = "sk_your_elevenlabs_key_here"

# ── Groq (optional STT acceleration) ─────────────────────────────────────────
[groq]
GROQ_API_KEY = "gsk_your_groq_key_here"

# ── Whisper model size ────────────────────────────────────────────────────────
[whisper]
MODEL_SIZE = "base"
